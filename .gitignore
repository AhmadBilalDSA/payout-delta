# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev server logs
.dev-server.err
.dev-server.log
.dev-server.*
*.log
*.err

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (scripts/playwright_scraper.py)
__pycache__/
*.py[cod]

# build outputs
dist/

# phase 6 backup archives (kept local, ignored)
backups/
*.zip

# Repomix artifacts
repomix-output.xml
repomix.config.json


# Security & IDE
*.key
*.p12
*.pfx
id_rsa*
.turbo
.vscode/*
!.vscode/settings.json

# --- Hardened security surface (least-privilege tracking lock) ---
# Local/editor-override payloads that must never enter the object store
*.local

# Edge / hosting provider state (may embed deployment tokens)
.wrangler/
.netlify/
.firebase/

# AI design export artifacts (scratch output, not part of the shipped app)
stitch-exports/

# One-shot migration / patch scripts (throwaway, per ANTIGRAVITY.md 1.2)
temp_*.mjs
patch_*.mjs

# Private specs and private notes
.specs/private/

# Local certificate / keystore material
*.crt
*.csr
*.jks
*.keystore

# OS / tooling noise
Thumbs.db
.DS_Store

*.log
temp_*.mjs
patch_*.mjs
.specs/private/
.vercel
.wrangler/
