{
  "meta": {
    "schema": "payoutdelta/clearing-rails@1",
    "phase": "Phase 1 & 2 — hexagonal normalization",
    "railCount": 110,
    "conventions": {
      "id": "Globally unambiguous schemes use the operator's own acronym (RAAST, PIX, FEDWIRE, CHIPS, CHAPS, FPS, IMPS, NEFT, RTGS_IN, PHILPASS, INSTAPAY, PESONET, ZENGIN, BOJ_NET, SIC, BOK_WIRE, CBC_INTERBANK, ESAS, TARGET2, SEPA_INSTANT). Country-scoped schemes are prefixed with their ISO 3166-1 alpha-2 code (e.g. BR_STR, ID_BIFAST, ZA_RTC). Shared regional schemes use a supranational prefix (ME_RGT, WAEMU_RTGS, ECCB_RTGS).",
      "protocol": "RTGS = real-time gross settlement, INSTANT = always-on finality with a sub-10s credit, BATCH = scheduled multilateral clearing, CHAPS = sterling high-value CHAPS settlement.",
      "baseHopCutUSD": "Zero local-deduction sentinel. A registered clearing rail adds no correspondent hop, so every node carries 0. Any non-zero intermediary cut is modelled upstream in data/fees.json as defaultIntermediaryUSD, never here."
    },
    "disclaimer": "Informational benchmark derived from public scheme documentation. Finality windows, cut-off times and participation rules are set by the operator; confirm against the operating central bank before quoting a settlement time to a client."
  },
